<li class="task task--<%= task.statusModifier %>">
  <div class="task__main">
    <a class="task__title" href="/tasks/<%= task.id %>?returnTo=<%= encodeURIComponent(returnTo) %>"><%= task.title %></a>
    <div class="task__meta">
      <span class="badge badge--<%= task.statusModifier %>"><%= task.statusLabel %></span>
      <span class="task__meta-item<%= task.isOverdue ? ' task__meta-item--overdue' : '' %>">
        <%= task.hasDueDate ? `Срок: ${task.dueDateLabel}` : 'Без срока' %>
      </span>
      <% if (task.isOverdue) { %><span class="badge badge--overdue">Просрочена</span><% } %>
      <% if (task.attachmentCount > 0) { %>
        <span class="task__meta-item">Вложений: <%= task.attachmentCount %></span>
      <% } %>
    </div>
  </div>

  <div class="task__actions">
    <form class="button-row" method="post" action="/tasks/<%= task.id %>/status">
      <input type="hidden" name="returnTo" value="<%= returnTo %>" />
      <% task.quickActions.forEach((action) => { %>
        <button class="button button--small button--status-<%= action.modifier %>" type="submit" name="status" value="<%= action.value %>"><%= action.label %></button>
      <% }); %>
    </form>
    <span class="task__actions-divider"></span>
    <a class="button button--small button--quiet" href="/tasks/<%= task.id %>/edit?returnTo=<%= encodeURIComponent(returnTo) %>">Изменить</a>
    <form class="button-row" method="post" action="/tasks/<%= task.id %>/delete">
      <input type="hidden" name="returnTo" value="<%= returnTo %>" />
      <button class="button button--small button--danger" type="submit">Удалить</button>
    </form>
  </div>
</li>
