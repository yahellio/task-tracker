<form class="form" method="post" action="<%= action %>"<% if (withAttachments) { %> enctype="multipart/form-data"<% } %>>
  <input type="hidden" name="returnTo" value="<%= returnTo %>" />

  <div class="field">
    <label class="field__label" for="title">Название</label>
    <input
      class="field__control<%= errors.title ? ' field__control--invalid' : '' %>"
      id="title"
      name="title"
      type="text"
      maxlength="200"
      value="<%= form.title %>"
      required
    />
    <% if (errors.title) { %><p class="field__error"><%= errors.title %></p><% } %>
  </div>

  <div class="field">
    <label class="field__label" for="description">Описание</label>
    <textarea
      class="field__control<%= errors.description ? ' field__control--invalid' : '' %>"
      id="description"
      name="description"
      rows="5"
      maxlength="2000"
    ><%= form.description %></textarea>
    <% if (errors.description) { %><p class="field__error"><%= errors.description %></p><% } %>
  </div>

  <div class="field-row">
    <div class="field">
      <label class="field__label" for="status">Статус</label>
      <select class="field__control" id="status" name="status">
        <% statusOptions.forEach((option) => { %>
          <option value="<%= option.value %>"<%= option.value === form.status ? ' selected' : '' %>><%= option.label %></option>
        <% }); %>
      </select>
      <% if (errors.status) { %><p class="field__error"><%= errors.status %></p><% } %>
    </div>

    <div class="field">
      <label class="field__label" for="dueDate">Ожидаемая дата завершения</label>
      <input
        class="field__control<%= errors.dueDate ? ' field__control--invalid' : '' %>"
        id="dueDate"
        name="dueDate"
        type="date"
        value="<%= form.dueDate %>"
      />
      <% if (errors.dueDate) { %><p class="field__error"><%= errors.dueDate %></p><% } %>
    </div>
  </div>

  <% if (withAttachments) { %>
    <div class="field">
      <label class="field__label" for="<%= uploads.field %>">Вложения</label>
      <input class="field__control" id="<%= uploads.field %>" name="<%= uploads.field %>" type="file" multiple />
      <p class="field__hint">До <%= uploads.maxFiles %> файлов, не более <%= uploads.maxFileSizeMb %> МБ каждый.</p>
    </div>
  <% } %>

  <div class="form__actions">
    <button class="button button--primary" type="submit"><%= submitLabel %></button>
    <a class="button" href="<%= returnTo %>">Отмена</a>
  </div>
</form>
