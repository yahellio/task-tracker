<aside class="sidebar">
  <section class="panel">
    <h2 class="panel__title">Статус</h2>
    <nav class="statusnav">
      <% filters.tabs.forEach((tab) => { %>
        <a class="statusnav__item<%= tab.active ? ' statusnav__item--active' : '' %>" href="<%= tab.href %>">
          <span><%= tab.label %></span>
          <span class="statusnav__count"><%= tab.count %></span>
        </a>
      <% }); %>
    </nav>
  </section>

  <section class="panel">
    <h2 class="panel__title">Поиск и сортировка</h2>
    <form class="panel__form" method="get" action="/tasks">
      <input type="hidden" name="status" value="<%= filters.status %>" />

      <div class="field">
        <label class="field__label" for="search">Поиск</label>
        <input
          class="field__control"
          id="search"
          type="search"
          name="search"
          placeholder="Название или описание"
          value="<%= filters.search %>"
        />
      </div>

      <div class="field">
        <label class="field__label" for="sort">Сортировка</label>
        <select class="field__control" id="sort" name="sort">
          <% filters.sortOptions.forEach((option) => { %>
            <option value="<%= option.value %>"<%= option.selected ? ' selected' : '' %>><%= option.label %></option>
          <% }); %>
        </select>
      </div>

      <button class="button button--primary button--block" type="submit">Применить</button>
      <% if (!filters.isDefault) { %>
        <a class="button button--quiet button--block" href="/tasks">Сбросить фильтры</a>
      <% } %>
    </form>
  </section>
</aside>
