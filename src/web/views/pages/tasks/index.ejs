<%- include('../../partials/head') %>

<div class="workspace">
  <%- include('../../partials/sidebar') %>

  <div class="content">
    <header class="content__header">
      <h1 class="content__title">Задачи</h1>
      <p class="content__subtitle">Найдено: <%= countLabel %></p>
    </header>

    <% if (tasks.length === 0) { %>
      <p class="empty">Задач не найдено. Измените условия отбора или создайте новую задачу.</p>
    <% } else { %>
      <ul class="task-list">
        <% tasks.forEach((task) => { %>
          <%- include('../../partials/task-card', { task }) %>
        <% }); %>
      </ul>
    <% } %>
  </div>
</div>

<%- include('../../partials/foot') %>
