<%- include('../../partials/head') %>

<div class="stack">
  <p class="backlink"><a class="backlink" href="/tasks/<%= taskId %>">← К карточке задачи</a></p>
  <h1 class="stack__title">Редактирование задачи</h1>

  <% if (Object.keys(errors).length > 0) { %>
    <p class="notice">Проверьте заполнение формы.</p>
  <% } %>

  <div class="card">
    <%- include('../../partials/task-form', { action: `/tasks/${taskId}`, submitLabel: 'Сохранить', withAttachments: false }) %>
  </div>
</div>

<%- include('../../partials/foot') %>
