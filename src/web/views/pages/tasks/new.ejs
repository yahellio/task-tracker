<%- include('../../partials/head') %>

<div class="stack">
  <p class="backlink"><a class="backlink" href="<%= returnTo %>">← К списку задач</a></p>
  <h1 class="stack__title">Новая задача</h1>

  <% if (Object.keys(errors).length > 0) { %>
    <p class="notice">Проверьте заполнение формы. Выбранные файлы нужно прикрепить заново.</p>
  <% } %>

  <div class="card">
    <%- include('../../partials/task-form', { action: '/tasks', submitLabel: 'Создать задачу', withAttachments: true }) %>
  </div>
</div>

<%- include('../../partials/foot') %>
